# =====================================================================
# NexGain settings. Copy this file to ".env" and fill in the values.
# =====================================================================

# ---------------------------------------------------------------------
# 1. The app (.env). Only public values go here: anything starting with
#    EXPO_PUBLIC_ is built into the app, so anyone could read it.
#    NEVER put a client secret, secret key or the service_role key here.
# ---------------------------------------------------------------------

# Supabase > Project Settings > Data API (Project URL) and API Keys (anon / publishable key).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Customer quote page (docs/quote/index.html on GitHub Pages). Quote emails link here plus ?q=
EXPO_PUBLIC_QUOTE_PAGE_URL=

# ---------------------------------------------------------------------
# 2. Server secrets: NOT in this file. They go in
#    Supabase > Edge Functions > Secrets (or: npx supabase secrets set NAME=value),
#    where only the Edge Functions can read them. Listed here so you know what's needed.
# ---------------------------------------------------------------------
#
# Encryption for saved logins (32 random bytes, base64):
#   TOKEN_ENCRYPTION_KEY
#
# Gmail (Google Cloud Console > Google Auth Platform > Clients):
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#
# Outlook (Microsoft Entra admin center > App registrations):
#   MICROSOFT_CLIENT_ID
#   MICROSOFT_CLIENT_SECRET
#
# Square (developer.squareup.com > Applications > your app > OAuth / Credentials):
#   SQUARE_APPLICATION_ID       Sandbox one while testing, Production one for real sellers
#   SQUARE_APPLICATION_SECRET   matching Sandbox / Production secret
#   SQUARE_ENVIRONMENT          "sandbox" while testing, "production" for real sellers
#
# Job reminders timer (any long random password; the same one is kept in Supabase Vault):
#   REMINDERS_CRON_SECRET
#
# Added automatically by Supabase (don't set these): SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#
# Every provider's redirect URL is the same Edge Function:
#   https://YOUR-PROJECT-REF.supabase.co/functions/v1/oauth-callback
